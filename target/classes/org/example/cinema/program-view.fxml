<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.cinema.programController"
            style="-fx-background-color: #2b2b2b;">
    <top>
        <Label text="Cinema program"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"
               BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets top="10" bottom="10"/>
            </BorderPane.margin>
        </Label>
    </top>
    <left>
        <VBox spacing="10" prefWidth="250" style="-fx-padding: 10;"> <Label text="Available movies" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
            <VBox spacing="5">
                <Label text="Filter by Genre:" style="-fx-text-fill: #bdc3c7; -fx-font-size: 12px;"/>
                <ComboBox fx:id="genreFilterComboBox" prefWidth="230" promptText="All Genres"/>
            </VBox>
            <ListView fx:id="moviesListView" VBox.vgrow="ALWAYS" style="-fx-control-inner-background: #2b2b2b; -fx-text-fill: white;"/>
            <Label fx:id="totalMoviesLabel" text="Total movies: 0" style="-fx-text-fill: white;"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="10" style="-fx-padding: 10;">
            <Label text="Details" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
            <GridPane hgap="10" vgap="10">
                <Label text="Title:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: white;"/>
                <Label fx:id="titleLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-text-fill: white;"/>
                <Label text="Genre:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: white;"/>
                <Label fx:id="genreLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-text-fill: white;"/>
                <Label text="Format:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-text-fill: white;"/>
                <Label fx:id="formatLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-text-fill: white;"/>
                <Label text="Duration:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-text-fill: white;"/>
                <Label fx:id="durationLabel" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-text-fill: white;"/>
                <Label text="Parental consent:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-text-fill: white;"/>
                <Label fx:id="parentalConsentLabel" GridPane.rowIndex="4" GridPane.columnIndex="1" style="-fx-text-fill: white;"/>
                <Label text="Program:" GridPane.rowIndex="5" GridPane.columnIndex="0"
                       style="-fx-text-fill: white;"/>
                <ComboBox fx:id="dateTimeComboBox"
                          GridPane.rowIndex="5"
                          GridPane.columnIndex="1"
                          prefWidth="200"/>
                <TextArea fx:id="descriptionArea"
                          editable="false"
                          wrapText="true"
                          prefRowCount="4"
                          GridPane.rowIndex="6"
                          GridPane.columnIndex="1"
                          style="-fx-control-inner-background: #2b2b2b; -fx-text-fill: white;"/>
            </GridPane>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10;">
            <Button text="Make a reservation"
                    fx:id="reservationButton"
                    onAction="#handleReservation"
                    style="-fx-background-color: #FFD700; -fx-text-fill: #2b2b2b;"/>
        </HBox>
    </bottom>
</BorderPane>
