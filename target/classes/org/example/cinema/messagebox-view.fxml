<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.cinema.messageboxController"
            style="-fx-background-color: #2b2b2b;"
            prefWidth="500"
            prefHeight="150">
    <VBox spacing="20" alignment="CENTER"
          AnchorPane.topAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">
        <Label fx:id="messageLabel"
               text="Mesaj"
               style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
        <Button fx:id = "okButton"
                text="OK"
                prefWidth="100"
                onAction="#onOkClicked"
                style="-fx-background-color: #f1c40f; -fx-text-fill: #2b2b2b;"/>
    </VBox>
</AnchorPane>
